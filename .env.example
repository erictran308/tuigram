# Optional overrides, mainly for development. Copy to .env in the directory you run from.

# API credentials (https://my.telegram.org → API development tools). Without
# these, tuigram asks for them on first run and saves them in the data directory.
# TG_API_ID=
# TG_API_HASH=

# Where TDLib stores its database (your login session), downloads and settings.
# Default: the platform's app data directory (see `tuigram --help`).
# TG_DATA_DIR=./.tdlib
